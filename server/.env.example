# Server
PORT=3000
MONGODB_URI=mongodb://localhost:27017/vue-practice

# LLM provider: qwen | deepseek | openai | ollama
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus

# Qwen
QWEN_API_KEY=
QWEN_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# OpenAI
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Ollama
OLLAMA_API_URL=http://localhost:11434/api/chat

# ── Agent ────────────────────────────────────────────────────────────────────
AGENT_ENABLED=true
AGENT_MAX_ITERATIONS=5
# 千问 OpenAI 兼容模式地址（Function Calling 必需）
QWEN_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── RAG / 向量检索 ───────────────────────────────────────────────────────────
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=text-embedding-v3
# 留空则复用 QWEN_API_KEY
EMBEDDING_API_KEY=
RAG_TOP_K=4
RAG_MIN_SCORE=0.3
RAG_PRERETRIEVE=true

# ── 联网搜索（可选）──────────────────────────────────────────────────────────
TAVILY_API_KEY=
